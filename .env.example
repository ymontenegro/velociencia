# Site URL (for sitemap and OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Unsplash Access Key (optional, agentic cover image fetching)
UNSPLASH_ACCESS_KEY=

# ── Admin / seguridad ──────────────────────────────────────────────────
# OBLIGATORIAS en producción: el arranque falla si faltan (src/lib/admin/auth.ts).
# ADMIN_SECRET firma las cookies de sesión — genera uno con: openssl rand -hex 32
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_SECRET=

# Salt para hashear IPs en la analítica propia (recomendado en producción).
# Genera uno con: openssl rand -hex 32
IP_HASH_SALT=

# ── Monetización: afiliados (Fase 2) ───────────────────────────────────
# Amazon Associates: tu tag de seguimiento (p. ej. velociencia-20). Se añade
# automáticamente a los enlaces de Amazon vía buildAffiliateUrl. Sin esto los
# enlaces siguen funcionando, pero no generan comisión.
NEXT_PUBLIC_AMAZON_TAG=

# Para las demás redes (AvantLink, Awin, Impact, ShareASale, CJ) NO hay env:
# el escritor pega el deep link generado por la red como `url` del producto/enlace.

# ── Monetización: patrocinador de la newsletter ────────────────────────
# El SponsorSlot solo aparece si NAME y URL están seteados (TAGLINE es opcional).
NEXT_PUBLIC_NEWSLETTER_SPONSOR_NAME=
NEXT_PUBLIC_NEWSLETTER_SPONSOR_URL=
NEXT_PUBLIC_NEWSLETTER_SPONSOR_TAGLINE=
